# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin IDs (comma-separated). These users can manage orders.
ADMIN_CHAT_ID=123456789

# Super-admin IDs (comma-separated). These users can grant rights and change notification recipients.
SUPER_ADMIN_IDS=123456789

# Optional: IDs that receive push notifications for new orders.
# If empty, ADMIN_CHAT_ID is used.
ORDER_NOTIFY_CHAT_IDS=123456789

# Optional: blocked Telegram user IDs (comma-separated).
BLOCKED_CHAT_IDS=

# Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit)
GOOGLE_SHEET_ID=https://docs.google.com/spreadsheets/d/1nb7A0nCucAwz2ylBrIl65OQ5J3LgbqHErS5nkrK2rH0/edit?gid=0#gid=0
# Name of the worksheet tab (default: Sheet1)
WORKSHEET_NAME=Sheet1
